{#
  @file
  Template for rendering a Views Vanilla Javascript Tabs.

  Available variables:
  - options: The options array containing settings for the tabs.
  - rows: An array of row items to be displayed in the tabs.
  - attributes: A list of HTML attributes for the wrapper div.

  Options settings:
  - unique_id: A unique identifier for the tabs instance.
  - animation: Animation type for the tabs.
  - max_width: Maximum width for the tabs.
  - available_breakpoints: Breakpoints for responsive design.
  - vertical_tabs: Whether to display tabs vertically.
#}

{#
  This template dynamically assigns CSS classes to a container based on user configuration options.
  - 'vvjt': A base class for general styling.
  - `vvjt_id`: A unique identifier class for targeting specific instances.
  - `options.tabs_position`: Adds a class for the tab position, which can be 'top', 'right', 'bottom', or 'left'.
  - `options.max_width`: Determines the max width class. If tabs are positioned 'left' or 'right' and 'auto' is selected,
    the max width defaults to 'tw-300'. For 'top' or 'bottom', 'auto' is included if selected.
  - `options.available_breakpoints`: Applied only if the tabs are vertical ('left' or 'right') to control responsive behavior.
  - `options.animation`: Adds the animation class unless the animation is set to 'none'.
  - `options.wrap_tabs`: Chooses between 'wrap-tabs' and 'auto-scroll-tabs' based on the user's wrapping preference.

  The code ensures that only relevant and non-empty classes are included in the output, optimizing styling and responsiveness.
#}
{% set unique_id = options.unique_id %}
{% set vvjt_id = 'vvjt-' ~ unique_id %}
{% set tab_inner_id = 'vvjt-inner-' ~ unique_id %}
{% set tab_layout = options.tabs_position in ['top', 'bottom'] ? 'horizontal' : 'vertical' %}
{% set classes = [
  'vvjt',
  vvjt_id,
  tab_layout,
  options.tabs_position,
  options.max_width != 0 ? 'max-w': '',
  options.max_height != 0 ? 'max-h': '',
  options.tabs_position in ['left', 'right'] ? options.available_breakpoints : '',
  options.animation != 'none' ? options.animation : '',
  options.wrap_tabs ? 'wrap-tabs' : '',
] %}

{% set background_buttons = '' %}
{% if options.background_buttons and not options.disable_background %}
  {% set background_buttons = 'background-color:' ~ options.background_buttons ~ '; ' %}
{% endif %}

{% set background_panes = '' %}
{% if options.background_buttons and not options.disable_background %}
  {% set background_panes = 'background-color:' ~ options.background_panes ~ '; ' %}
{% endif %}

{% set max_height = '' %}
{% if options.max_height > 0 and tab_layout == 'vertical' %}
  {% set max_height = 'max-height:' ~ options.max_height ~ 'px; height: 100%; ' %}
{% endif %}

{% set vertical_width = '' %}
{% set horizontal_width = '' %}

{% if options.max_width > 0 %}
  {% if tab_layout == 'vertical' %}
    {% set vertical_width = 'max-width:' ~ options.max_width ~ 'px; width: 100%; ' %}
  {% elseif tab_layout == 'horizontal' %}
    {% set horizontal_width = 'max-width:' ~ options.max_width ~ 'px; width: 100%; ' %}
  {% endif %}
{% endif %}

<div {{ attributes.addClass(classes).setAttribute('id', vvjt_id) }}>
    <div id="{{ tab_inner_id }}" class="vvjt-inner">

      {# Initialize variables to hold the buttons and panes #}
      {% set buttons = '' %}
      {% set panes = '' %}

      {# Capture the buttons and panes from each row #}
      {% for key, row in rows %}
        {% set row_content = row.content|render %}

        {# Use the unique tag or CSS class to split the content #}
        {% set split_content = row_content|split('<div class="vvjt-separator"></div>') %}
        {% set button_content = split_content[0] %}
        {% set pane_content = split_content[1]|default('') %}

        {# Define a valid ID for the pane controlled by the button #}
        {% set pane_id = 'vvjt-pane-' ~ unique_id ~ '-' ~ (key + 1) %}

        {# Render the button #}
        {% set button %}
        <button id="vvjt-button-{{ unique_id }}-{{ key + 1 }}" class="button vvjt-button" aria-label="{{ button_content|striptags|trim|t }}" aria-selected="{{ key == 0 ? 'true' : 'false' }}" aria-controls="{{ pane_id }}" aria-expanded="{{ key == 0 ? 'true' : 'false' }}" type="button" role="tab" {% if key != 0 %}tabindex="-1"{% endif %} {% if horizontal_width %} style="{{ horizontal_width }}"{% endif %}>
          {{ button_content|safe_html }}
        </button>
        {% endset %}

        {# Render the pane #}
        {% set pane %}
        <div id="{{ pane_id }}" role="tabpanel" data-index="{{ key + 1 }}" aria-hidden="{{ key == 0 ? 'false' : 'true' }}" aria-labelledby="vvjt-button-{{ unique_id }}-{{ key + 1 }}" class="vvjt-pane" {% if key == 0 %} aria-live="polite"{% endif %}>
          {{ pane_content|safe_html }}
        </div>
        {% endset %}

        {# Collect the buttons and panes #}
        {% set buttons = buttons ~ button %}
        {% set panes = panes ~ pane %}
      {% endfor %}

      {# Render the tab buttons. #}
      <div class="tab-buttons" role="tablist" aria-label="{{ 'Tab List'|t }}"{% if background_buttons or max_height or vertical_width %} style="{{ background_buttons }}{{ max_height }}{{ vertical_width }}"{% endif %}>

        <span class="visually-hidden">{{ 'Use the arrow keys to navigate between tabs'|t }}</span>
        {{ buttons|safe_html }}
      </div>

      {# Render the tab content. #}
      <div class="tab-panes"{% if background_panes %} style="{{ background_panes }}"{% endif %}>
        {{ panes|safe_html }}
      </div>

    </div> {# End of vvjt-inner #}
</div> {# End of main wrapper #}
